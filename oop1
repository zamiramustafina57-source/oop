class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year

    def get_info(self):
        print(f'Название: {self.title}\nАвтор: {self.author}\nГод издания: {self.year}')


book = Book("Война и мир", "Лев Толстой", 1869)
book.get_info()
